#!/bin/sh
set -eu

if [ "$1" = purge ]; then
    rm -f /etc/systemd/system/multi-user.target.wants/supersurveyor.service
    rm -f /etc/supersurveyor/settings.json /etc/supersurveyor/.configure.lock \
        /etc/supersurveyor/.migration-pending /var/lib/supersurveyor/state.json
    rmdir /etc/supersurveyor /var/lib/supersurveyor 2>/dev/null || true
fi

case "$1" in
    remove|purge)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
        fi
        ;;
esac
