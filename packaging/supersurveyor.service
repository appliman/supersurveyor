[Unit]
Description=SuperSurveyor system monitor
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/supersurveyor/settings.json

[Service]
Type=simple
User=supersurveyor
Group=supersurveyor
ExecStart=/usr/bin/supersurveyor monitor
LoadCredential=settings.json:/etc/supersurveyor/settings.json
StateDirectory=supersurveyor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
